guid: 2fd419dc-032b-4c36-89f6-2a8b7e5bc0a7
model:
  name: Brant Test Connection
  model_tables:
  - name: DIM_RETAPP_PRODUCTS
    fqn: cc0eaae5-546c-4804-ac48-99f0e1a976ec
  - name: DIM_RETAPP_STORES
    fqn: 1d65c20a-b23f-42b3-8f6a-d234fd5c8d57
  - name: FACT_RETAPP_SALES
    fqn: bf4bdeb3-f2f2-492a-86fd-efaadba93d0a
    joins:
    - with: DIM_RETAPP_PRODUCTS
      referencing_join: C_DIM_RETAPP_PRODUCTS
    - with: DIM_RETAPP_STORES
      referencing_join: C_DIM_RETAPP_STORES
  columns:
  - name: Product name
    column_id: DIM_RETAPP_PRODUCTS::PRODUCTNAME
    properties:
      column_type: ATTRIBUTE
  - name: Product type
    column_id: DIM_RETAPP_PRODUCTS::PRODUCTTYPE
    properties:
      column_type: ATTRIBUTE
  - name: City
    column_id: DIM_RETAPP_STORES::CITY
    properties:
      column_type: ATTRIBUTE
  - name: County
    column_id: DIM_RETAPP_STORES::COUNTY
    properties:
      column_type: ATTRIBUTE
      geo_config:
        region_name:
          country: UNITED STATES
          region_name: county
  - name: Region
    column_id: DIM_RETAPP_STORES::REGION
    properties:
      column_type: ATTRIBUTE
  - name: State
    column_id: DIM_RETAPP_STORES::STATE
    properties:
      column_type: ATTRIBUTE
      geo_config:
        region_name:
          country: UNITED STATES
          region_name: state
  - name: Store
    column_id: DIM_RETAPP_STORES::STORENAME
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Store Name
  - name: Price
    column_id: FACT_RETAPP_SALES::ITEMPRICE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Item Price
  - name: Qty
    column_id: FACT_RETAPP_SALES::QUANTITYPURCHASED
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Item Qty
      - Quantity
      - ''
  - name: Date
    column_id: FACT_RETAPP_SALES::RECORDDATE
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: Sales
    column_id: FACT_RETAPP_SALES::SALES
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Revenue
  properties:
    is_bypass_rls: false
    join_progressive: true
    sage_config:
      is_sage_enabled: false
