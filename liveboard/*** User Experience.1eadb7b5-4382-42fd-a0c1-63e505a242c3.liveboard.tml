  - id: Viz_7
    viz_guid: fd249886-fef8-44ab-9785-7f1eedbabd6b
    note_tile:
      html_parsed_string: "<h2 class=\"theme-module__editor-h2\" dir=\"ltr\"><span style=\"color: rgb(182, 49, 62); white-space: pre-wrap;\">Read Me</span></h2><p class=\"theme-module__editor-paragraph\"><br></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">Understanding what's slowing down your analytics experience is no longer a guessing game. With this custom User Experience Liveboard, you get a clear view into query latency, broken down into Internal and External components, with the ability to drill into individual Liveboards that are underperforming.</span></p><p class=\"theme-module__editor-paragraph\"><br></p><h2 class=\"theme-module__editor-h2\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">What the liveboard measures</span></h2><ul class=\"theme-module__editor-ul\"><li value=\"1\" class=\"theme-module__editor-list-item\"><span style=\"white-space: pre-wrap;\">Internal Latency: Time spent within ThoughtSpot (query generation, formula evaluation, joins, rendering)</span></li><li value=\"2\" class=\"theme-module__editor-list-item\"><span style=\"white-space: pre-wrap;\">External Latency: Time waiting on the backend data warehouse (e.g., Snowflake, BigQuery)\L- Total Latency: The full user-perceived load time from query to result</span></li></ul><p class=\"theme-module__editor-paragraph\"><br></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">Click </span><a href=\"https://docs.google.com/document/d/1lI0DvZdPbsKShBsBz4_3rtcsGcocvdo9MBnQBB281Wo/edit?tab=t.0\" target=\"_blank\" rel=\"noreferrer\" class=\"theme-module__editor-link\"><span style=\"white-space: pre-wrap;\">here for the knowledge article</span></a><span style=\"white-space: pre-wrap;\"> on how to make best of this Liveboard.</span></p><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\" style=\"background-color: rgb(255, 255, 255);\"></div>"
  layout:
