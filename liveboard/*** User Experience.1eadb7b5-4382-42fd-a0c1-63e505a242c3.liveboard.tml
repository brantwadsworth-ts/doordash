          numberFormatConfig:
            unit: THOUSANDS
            decimals: 0.0
            negativeValueFormat: PREFIX_DASH
            toSeparateThousands: true
          isCategoryEditable: true
      - name: '> 15s'
        format:
          category: NUMBER
          numberFormatConfig:
            unit: THOUSANDS
            decimals: 0.0
            negativeValueFormat: PREFIX_DASH
            toSeparateThousands: true
          isCategoryEditable: true
      - name: '> 30s'
        format:
          category: NUMBER
          numberFormatConfig:
            unit: NONE
            decimals: 0.0
            negativeValueFormat: PREFIX_DASH
            toSeparateThousands: true
          isCategoryEditable: true
      - name: '> 5s'
        format:
          category: NUMBER
          numberFormatConfig:
            unit: THOUSANDS
            decimals: 0.0
            negativeValueFormat: PREFIX_DASH
            toSeparateThousands: true
          isCategoryEditable: true
      - name: Average External Latency (s)
        custom_name: Avg Ext Late (s)
      - name: Average Internal Latency (s)
        custom_name: Avg Int Late (s)
      - name: Optimal %
        custom_name: '% Optimal'
        format:
