liveboard:
  name: '*** User Experience'
  visualizations:
  - id: Viz_1
    answer:
      name: Latency by Week
      tables:
      - id: "TS: Query Stats Worksheet"
        name: "TS: Query Stats Worksheet"
        fqn: 321647b5-b057-4b4d-b455-0cf041e4defe
      formulas:
      - id: '% Late'
        name: '% Late'
        expr: "[> 15s] / unique count ( [Query ID] )"
        was_auto_generated: false
      - id: '% Suboptimal'
        name: '% Suboptimal'
        expr: "[> 5s] / unique count ( [Query ID] )"
        was_auto_generated: false
      - id: '% Unusable'
        name: '% Unusable'
        expr: "[> 30s] / unique count ( [Query ID] )"
        was_auto_generated: false
      - id: '> 15s'
        name: '> 15s'
        expr: "unique_count_if ( ( [Query Latency (External)] > 15000 and ( [Query Latency (External)] < 30000 ) ) , [Query ID] )"
        was_auto_generated: false
      - id: '> 30s'
        name: '> 30s'
        expr: "unique_count_if ( ( [Query Latency (External)] > 30000 ) , [Query ID] )"
        was_auto_generated: false
      - id: '> 5s'
        name: '> 5s'
        expr: "unique_count_if ( ( [Query Latency (External)] > 5000 ) and ( [Query Latency (External)] < 15000 ) , [Query ID] )"
        was_auto_generated: false
      - id: External Latency (s)
        name: External Latency (s)
        expr: "[Query Latency (External)] / 1000"
        was_auto_generated: false
      - id: Internal Latency (s)
        name: Internal Latency (s)
        expr: "( [Query Latency (Overall)] - [Query Latency (External)] ) / 1000"
        was_auto_generated: false
      - id: Optimal %
        name: Optimal %
        expr: "[< 5s] / unique count ( [Query ID] )"
        was_auto_generated: false
      - id: < 5s
        name: < 5s
        expr: "unique_count_if ( [Query Latency (External)] <= 5000 , [Query ID] )"
        was_auto_generated: false
      search_query: "[Query Start Date].weekly [Query Start Date].'last 30 days' unique count [Query ID] [> 15s] [% Late] [Is System].false [Query Task] != '{null}' [> 30s] [% Unusable] [> 5s] [% Suboptimal] [< 5s] [Optimal %] average [Internal Latency (s)] average [External Latency (s)] sort by [Query Start Date] [Query Start Date].weekly"
      answer_columns:
      - name: '% Late'
        format:
          category: PERCENTAGE
          percentageFormatConfig:
            decimals: 0.0
          isCategoryEditable: true
      - name: '% Suboptimal'
        custom_name: '% Sub optimal'
        format:
          category: PERCENTAGE
          percentageFormatConfig:
            decimals: 0.0
          isCategoryEditable: true
      - name: '% Unusable'
