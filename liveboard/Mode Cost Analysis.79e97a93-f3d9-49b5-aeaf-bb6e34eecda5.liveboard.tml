  - id: Viz_3
    answer:
      name: Mode Weekly Report Count
      description: This shows the number of mode report created on the weekly basis.
      tables:
      - id: Mode Cost Exploration
        name: Mode Cost Exploration
        fqn: 7df0fe59-1fe4-4f26-8430-dbdd07734b61
      search_query: "unique count [Report Id] [Create Date].weekly [Create Date] = 'year to date' [Create Date] != 'this week'"
      answer_columns:
      - name: Unique Number of Report Id
        format:
          category: NUMBER
          numberFormatConfig:
            unit: NONE
            decimals: 0.0
            negativeValueFormat: PREFIX_DASH
            toSeparateThousands: true
          isCategoryEditable: true
      - name: Week(Create Date)
      table:
        table_columns:
        - column_id: Unique Number of Report Id
          headline_aggregation: AVERAGE
        - column_id: Week(Create Date)
          headline_aggregation: MIN-MAX
        ordered_column_ids:
        - Week(Create Date)
        - Unique Number of Report Id
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\"}"
      chart:
        type: KPI
        chart_columns:
        - column_id: Unique Number of Report Id
        - column_id: Week(Create Date)
        axis_configs:
        - x:
          - Week(Create Date)
          "y":
          - Unique Number of Report Id
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"responsiveLayoutPreference\": \"AUTO_ON\",\"chartSpecific\": {\"pivotSummariesState\": {}}},\"columnProperties\": [{\"columnId\": \"Week(Create Date)\",\"columnProperty\": {}},{\"columnId\": \"Unique Number of Report Id\",\"columnProperty\": {}},{\"columnId\": \"7181f150-ae6d-4ffc-b7f3-1297b3149f00\",\"columnProperty\": {}},{\"columnId\": \"ec3bbef0-b0cb-48ac-a74b-d31934703a3e\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"a435f83c-cc88-4eac-b386-33f8f2c88ede\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Unique Number of Report Id\"],\"isOpposite\": false}},{\"id\": \"a21286fc-d1ad-4c7e-b2bf-a3828fac3a07\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Week(Create Date)\"]}}],\"systemSeriesColors\": [{\"serieName\": \"Unique Number of Report Id\",\"color\": \"#06BF7F\"}]}"
