  - id: Viz_1
    answer:
      name: Total GOV Daily Trend
      description: This graph shows the daily GOV Trend for Last Month
      tables:
      - id: FDA Core Model
        name: FDA Core Model
        fqn: a3b3b8c4-fc90-4553-a2f3-ba75cf497072
      search_query: "[Gov] [Active Date] [Active Date].daily [Active Date] [Active Date].'last month'"
      answer_columns:
      - name: Day(Active Date)
      - name: Total Gov
      table:
        table_columns:
        - column_id: Day(Active Date)
          headline_aggregation: MIN-MAX
        - column_id: Total Gov
          headline_aggregation: SUM
        ordered_column_ids:
        - Day(Active Date)
        - Total Gov
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\"}"
      chart:
        type: LINE
        chart_columns:
        - column_id: Day(Active Date)
        - column_id: Total Gov
        axis_configs:
        - x:
          - Day(Active Date)
          "y":
          - Total Gov
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"pivotSummariesState\": {}}},\"columnProperties\": [{\"columnId\": \"Total Gov\",\"columnProperty\": {}},{\"columnId\": \"Day(Active Date)\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"80b625ac-a012-4f0e-bbf2-6a1dccb11bc3\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Day(Active Date)\"],\"name\": \"Date\",\"dynamicTitle\": \"Date\"}},{\"id\": \"5c4584c5-6654-4074-a7c7-7ad9e2c12278\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Gov\"],\"name\": \"GOV\",\"isOpposite\": false,\"dynamicTitle\": \"GOV\"}}],\"systemSeriesColors\": [{\"serieName\": \"Total Gov\",\"color\": \"#2E75F0\"}]}"
