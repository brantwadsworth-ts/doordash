  joins_with:
  - name: FACT_DELIVERY_ALLOCATION_to_DIMENSION_CONSUMERS
    destination:
      name: DIMENSION_CONSUMERS
      fqn: f6e29637-0f8a-4207-9578-229f90a94972
    "on": "[FACT_DELIVERY_ALLOCATION::CREATOR_ID] = [DIMENSION_CONSUMERS::CONSUMER_ID]"
    type: LEFT_OUTER
  - name: FACT_DELIVERY_ALLOCATION_to_DIMENSION_DATES
    destination:
      name: DIMENSION_DATES
      fqn: 1c4c2bdb-054a-43ab-b5e0-8e761587f5a1
    "on": "[FACT_DELIVERY_ALLOCATION::ACTIVE_DATE] = [DIMENSION_DATES::CALENDAR_DATE]"
    type: LEFT_OUTER
  - name: FACT_DELIVERY_ALLOCATION_to_DIMENSION_STORE
    destination:
      name: DIMENSION_STORE
      fqn: b12d0ccb-3a74-4b7e-b763-b9972c6af966
    "on": "[FACT_DELIVERY_ALLOCATION::STORE_ID] = [DIMENSION_STORE::STORE_ID]"
    type: LEFT_OUTER
  properties:
    sage_config:
      is_sage_enabled: false
