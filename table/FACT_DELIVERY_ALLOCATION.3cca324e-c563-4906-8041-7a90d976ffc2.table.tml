guid: 3cca324e-c563-4906-8041-7a90d976ffc2
table:
  name: FACT_DELIVERY_ALLOCATION
  db: EDW
  schema: FINANCE
  db_table: FACT_DELIVERY_ALLOCATION
  connection:
    name: dd_snow_test_dd
    fqn: 49cf2059-2326-45b2-9a18-92bc6af4e79d
  columns:
  - name: ACTIVE_DATE
    description: Delivery completed date
    db_column_name: ACTIVE_DATE
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DATE
  - name: DELIVERY_ID
    description: delivery unique identifier (primary key)
    db_column_name: DELIVERY_ID
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: SUBMARKET
    description: Submarket name of the store
    db_column_name: SUBMARKET
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: VARCHAR
  - name: SUBMARKET_ID
    description: Submarket identifier
    db_column_name: SUBMARKET_ID
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: STORE_STARTING_POINT_ID
    description: Store starting point ID
    db_column_name: STORE_STARTING_POINT_ID
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: PICKUP_ADDRESS_ID
    description: Store address ID
    db_column_name: PICKUP_ADDRESS_ID
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: DELIVERY_ADDRESS_ID
    description: Customer address ID
    db_column_name: DELIVERY_ADDRESS_ID
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: SUBMIT_PLATFORM
    description: "Platform (iOS, Android, Desktop) where order was submitted"
    db_column_name: SUBMIT_PLATFORM
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: VARCHAR
  - name: CREATOR_ID
    description: Customer unique identifier
    db_column_name: CREATOR_ID
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: STORE_ID
    description: Store identifier for the physical location
    db_column_name: STORE_ID
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: DASHER_ID
    description: Dasher who completed the delivery
    db_column_name: DASHER_ID
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: BUSINESS_UNIT
    description: Line of Business. Each delivery belongs to one of the business unit
    db_column_name: BUSINESS_UNIT
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: VARCHAR
  - name: IS_FILTERED
    description: cancelled_at IS NULL AND parent_delivery_id IS NULL AND actual_delivery_time IS NOT NULL AND is_test is FALSE
    db_column_name: IS_FILTERED
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: BOOL
  - name: IS_FILTERED_INCL_REDELIV
    description: cancelled_at IS NULL AND actual_delivery_time IS NOT NULL AND is_test is FALSE
    db_column_name: IS_FILTERED_INCL_REDELIV
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: BOOL
  - name: IS_CAVIAR
    description: Flag for catering deliveries
    db_column_name: IS_CAVIAR
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: BOOL
  - name: SUBTOTAL
    description: Subtotal of order
    db_column_name: SUBTOTAL
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: GMV_DRIVE_ADJUSTMENT
    description: "For Drive – Subtotal, Tax are not part of GMV/GOV"
    db_column_name: GMV_DRIVE_ADJUSTMENT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: DELIVERY_FEE
    description: "Delivery fee column which also includes expand range fee, priority fee, and accounting difference. This is included in consumer_revenue, gross_fee, gov, and storefront_gov"
    db_column_name: DELIVERY_FEE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: DELIVERY_FEE_TT
    description: Delivery Fee for the delivery - DashPass Delivery Fee discount excluding any allocation
    db_column_name: DELIVERY_FEE_TT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: DELIVERY_FEE_AD
    description: Delivery Fee Accounting Difference
    db_column_name: DELIVERY_FEE_AD
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: DELIVERY_FEE_NO_DSCNT
    description: Delivery Fee with subscription discount not being applied to. Also includes SOS fee
    db_column_name: DELIVERY_FEE_NO_DSCNT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: SOS_FEE
    description: Surge cost
    db_column_name: SOS_FEE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: SERVICE_FEE
    description: Service Fee with subscription discount applied. This service fee is net of Marqeta overcharge reduction
    db_column_name: SERVICE_FEE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: SERVICE_FEE_TT
    description: Service Fee for the delivery - DashPass Delivery Fee discount excluding any allocation
    db_column_name: SERVICE_FEE_TT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: SERVICE_FEE_AD
    description: Service Fee Accounting Difference
    db_column_name: SERVICE_FEE_AD
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: SERVICE_FEE_NO_DSCNT
    description: Service Fee with subscription discount not being applied to. This service fee is net of Marqeta overcharge reduction
    db_column_name: SERVICE_FEE_NO_DSCNT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: SMALL_ORDER_FEE
    description: "Small order fee, if it exists"
    db_column_name: SMALL_ORDER_FEE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: MERCHANT_MARKETING_FEE
    description: Flat commission from Store Order Cart table
    db_column_name: MERCHANT_MARKETING_FEE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: MERCHANT_MARKETING_FEE_ALLOC
    description: Merchant Marketing Fees which comes from transactions + Store Payment Advertising Fee + Merchant Funded Promo + Storefront Loyalty Discount + Storefront External Mx Gift Card Credit
    db_column_name: MERCHANT_MARKETING_FEE_ALLOC
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: TAX
    description: Tax amount
    db_column_name: TAX
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: FEES_TAX_AMOUNT
    description: This is for Canada. Tax amount is charged on the top of the fee and it is part of GOV
    db_column_name: FEES_TAX_AMOUNT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: TIP
    description: Tip amount
    db_column_name: TIP
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: DRIVE_FEE
    description: "For drive orders, this is the fee that merchants pay us to do the delivery"
    db_column_name: DRIVE_FEE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: DRIVE_FEE_ALLOC
    description: "drive_fee + dasher_regulatory_fee (this is fee charged to drive mx) + adjustment to drive fee, to match the accounting numbers"
    db_column_name: DRIVE_FEE_ALLOC
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: COMMISSION
    description: Commission charged for the order
    db_column_name: COMMISSION
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: COMMISSION_ALLOC
    description: Commission which came from transactions
    db_column_name: COMMISSION_ALLOC
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: REDELIVERIES
    description: Redeliveries cost in USD
    db_column_name: REDELIVERIES
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: REDELIVERIES_ALLOC
    description: Redeliveries cost available from Transactions + Manual Change made from Netsuite / Accounting for Chipotle Drive orders
    db_column_name: REDELIVERIES_ALLOC
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: SUPPORT_ACTUAL
    description: Support actual number
    db_column_name: SUPPORT_ACTUAL
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: SUPPORT_FORECAST
    description: support forecasted number
    db_column_name: SUPPORT_FORECAST
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: SUPPORT
    description: Support cost in USD
    db_column_name: SUPPORT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: DASHER_BASE_PAY
    description: Dasher base pay in USD (including express pay)
    db_column_name: DASHER_BASE_PAY
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: DASHER_PAY_OTHER
    description: Dasher Incentive Pay which is at delivery level
    db_column_name: DASHER_PAY_OTHER
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: REDELIV_DASHER_BASE_PAY
    description: Base pay for dasher for redelivery orders
    db_column_name: REDELIV_DASHER_BASE_PAY
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: REDELIV_DASHER_OTHER
    description: Dasher other pay for redelivery orders
    db_column_name: REDELIV_DASHER_OTHER
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: DASHER_CATCH_ALL
    description: "Any other dasher pay which does not fall in the Dasher Base Pay and Dasher Pay Other. In general, this is dasher pay which is not at delivery level. Dasher Min Wage Pay is included"
    db_column_name: DASHER_CATCH_ALL
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: DRIVER_PAY_ALLOC_ACTUAL
    description: Driver Pay actual number
    db_column_name: DRIVER_PAY_ALLOC_ACTUAL
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: DRIVER_PAY_ALLOC_FORECAST
    description: Driver Pay forecasted number
    db_column_name: DRIVER_PAY_ALLOC_FORECAST
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: DRIVER_PAY_ALLOC
    description: Driver_Pay_Alloc = Dasher_Base_Pay + Dasher_Pay_Other + Dasher_Catch_All + Driver_Pay_AD
    db_column_name: DRIVER_PAY_ALLOC
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: CONSUMER_REFUND
    description: Refund provided back to the consumer for any delivery errors
    db_column_name: CONSUMER_REFUND
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: SUBSCRIPTION_REFUND
    description: All of the DashPass subscription monthly fee ($9.99) - if refunded then it will be logged here. This is allocated column as well
    db_column_name: SUBSCRIPTION_REFUND
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: DASHPASS_MARKETING_FEE
    description: "Subscription flat fee from the merchants, on P&L, DashPass marketing fee rolls up to commission (included in Commission_Alloc)"
    db_column_name: DASHPASS_MARKETING_FEE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: STORE_CHARGE
    description: Charged to the store for any delivery errors made by the store
    db_column_name: STORE_CHARGE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: STORE_REFUND
    description: Refund provided back to the store for any delivery errors
    db_column_name: STORE_REFUND
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: STORE_PAYMENT_REFUND_TRUE_TO_STORE
    description: "All the adhoc refunds are logged in store payment, we are allocating them based on the store delivery within the week we see the refund"
    db_column_name: STORE_PAYMENT_REFUND_TRUE_TO_STORE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: STORE_PAYMENT_REFUND_ALLOCATED
    description: All the adhoc refund
    db_column_name: STORE_PAYMENT_REFUND_ALLOCATED
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: REFUNDS
    description: Refunds = Consumer_Refund + Store_Refund - Store_Charge + Subscription_Refund + Store_Payment_Refund_True_To_Store + Store_Payment_Refund_Allocated + (Extra Accounting Entries)
    db_column_name: REFUNDS
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: FIRST_DELIVERY_DISCOUNT
    description: first_delivery_discount
    db_column_name: FIRST_DELIVERY_DISCOUNT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: SUPPORT_CREDIT
    description: Support credit being redeemed
    db_column_name: SUPPORT_CREDIT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: SUPPORT_CREDIT_TT
    description: Support credit being redeemed (excluding any allocation)
    db_column_name: SUPPORT_CREDIT_TT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: SUPPORT_CREDIT_AD
    description: Support credit accounting difference
    db_column_name: SUPPORT_CREDIT_AD
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: CONSUMER_PROMOTIONS_ACTUAL
    description: Consumer promotions actual number
    db_column_name: CONSUMER_PROMOTIONS_ACTUAL
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: CONSUMER_PROMOTIONS_FORECAST
    description: Consumer promotions forecasted number
    db_column_name: CONSUMER_PROMOTIONS_FORECAST
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: CONSUMER_PROMOTIONS
    description: FIRST_TIME_PROMO_CODE_CREDIT + Accounting feed of promotions
    db_column_name: CONSUMER_PROMOTIONS
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: MERCHANT_PROMOTIONS
    description: "Merchant promotions such as Try me Free, Featured Partner etc."
    db_column_name: MERCHANT_PROMOTIONS
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: OTHER_PROMOTIONS
    description: (PROMO_CODE_CREDIT - fmx) + CONSUMER_RETENTION + FMX + FMX_OTHER_PROMOTIONS + PROMOTION_CATCH_ALL + PROMOTION_CREDIT + DRIVE_PROMO + MARQETA_OPERATIONAL_ERROR
    db_column_name: OTHER_PROMOTIONS
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: OTHER_PROMOTIONS_ALLOC
    description: "other promotions + chase_statement_credit + payment_to_customer + drive_payment_to_customer + accounting adjustments, to match the numbers from accounting"
    db_column_name: OTHER_PROMOTIONS_ALLOC
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: PAYMENT_TO_CUSTOMERS
    description: "Accounting Adjustment, This includes any type of adhoc payments to consumer or merchant. Payment to Customer is part of Other_Promotion_Alloc"
    db_column_name: PAYMENT_TO_CUSTOMERS
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: CHASE_STATEMENT_CREDIT
    description: Chase Statement Credit is part of Other_Promotion_Alloc
    db_column_name: CHASE_STATEMENT_CREDIT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: FMX
    description: total_promo_credits_used by %
    db_column_name: FMX
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: CONSUMER_RETENTION
    description: These are all credit redemptions which are classified under consumer retention program. GIFT_CODE_CREDIT + DELIVERY_GIFT_CREDIT + ACCOUNTING_CONSISTENCY_CREDIT + UPSELL_DELIVERY_DISCOUNT + MANUAL_CREDIT + OTHER_CREDIT
    db_column_name: CONSUMER_RETENTION
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: OTHER_PROMOTIONS_BASE
    description: PROMO_CODE_CREDIT - FMX
    db_column_name: OTHER_PROMOTIONS_BASE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: GIFT_CODE_CREDIT
    description: the one consumers get by applying the gift codes we sent them
    db_column_name: GIFT_CODE_CREDIT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: DELIVERY_GIFT_CREDIT
    description: Delivery gift credit applied to order
    db_column_name: DELIVERY_GIFT_CREDIT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: ACCOUNTING_CONSISTENCY_CREDIT
    description: Accounting consistency credit applied to order
    db_column_name: ACCOUNTING_CONSISTENCY_CREDIT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: UPSELL_DELIVERY_DISCOUNT
    description: Upsell Delivery Discount applied to order
    db_column_name: UPSELL_DELIVERY_DISCOUNT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: MANUAL_CREDIT
    description: "the one-time credit we add for various reasons like - new merchant, trial, etc"
    db_column_name: MANUAL_CREDIT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: OTHER_CREDIT
    description: the one consumers get when engineers run the script to add credits
    db_column_name: OTHER_CREDIT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: CONSUMER_REFERRALS_REFEREE_ACTUAL
    description: Referee portion of the referral cost. Source of information is Accounting
    db_column_name: CONSUMER_REFERRALS_REFEREE_ACTUAL
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: CONSUMER_REFERRALS_REFEREE_FORECAST
    description: Referee Portion of the Referral cost. Source of information is Finance Forecasting
    db_column_name: CONSUMER_REFERRALS_REFEREE_FORECAST
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: CONSUMER_REFERRALS_REFEREE
    description: Referee portion of the referral cost. Referee is defined as a person who is being introduced to the platform
    db_column_name: CONSUMER_REFERRALS_REFEREE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: SUBSCRIPTION_ALLOC
    description: DashPass subscription fee is being allocated to the subscribers deliveries
